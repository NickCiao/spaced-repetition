{
  "name": "spaced-repetition",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "deploy:safe": "npm test && wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply sr --local",
    "migrate:remote": "wrangler d1 migrations apply sr --remote",
    "db:wipe:local": "bash scripts/db-wipe-local.sh",
    "db:wipe:remote": "bash scripts/db-wipe-remote.sh",
    "test": "vitest run",
    "types": "wrangler types"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "katex": "^0.16.22",
    "marked": "^15.0.0",
    "ts-fsrs": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20260821.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.0.0"
  }
}
